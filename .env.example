# Optional. Enables AI content generation and free-form AI editing.
# Without it the app works end to end using the template generator.
GEMINI_API_KEY=

# Optional. Which Gemini model the hosted-AI features use.
# WG_GEMINI_MODEL=gemini-2.5-pro

# Optional. Where the SQLite database, uploads and published sites are stored.
# WG_DATA_DIR=./data

# Optional deploy targets. Built-in hosting works with no configuration.
# VERCEL_TOKEN=
# NETLIFY_AUTH_TOKEN=

# Optional. Publishes client websites to a PRIVATE GitHub repository served by
# GitHub Pages, which keeps working when this application is closed.
#
# Create an OAuth app at https://github.com/settings/developers and add
# <origin>/api/github/callback as the authorisation callback URL. The only
# scope requested is `repo`, which is the narrowest one that covers creating a
# private repository, pushing to it and configuring Pages; `public_repo` would
# make every client website public.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# Alternative for a single-operator install (the desktop build, or an agency
# running its own server): one token for everybody on this install, instead of
# each creator connecting their own account. Needs the same `repo` scope.
# Do NOT set this on a shared deployment — every creator would publish into
# this one account. Namespaced on purpose: a bare GITHUB_TOKEN is set by CI
# systems and by the gh CLI for their own reasons, and must never be mistaken
# for permission to publish client websites.
# WG_GITHUB_TOKEN=
# WG_GITHUB_LOGIN=
#
# Optional. Which resolvers to use when checking whether a client's custom
# domain points at GitHub Pages yet. Defaults to the system resolvers.
# WG_DNS_SERVERS=1.1.1.1,8.8.8.8

# Optional. Where the Ollama daemon lives; a small local model writes the
# design-catalogue queries. Without it a built-in rule set writes them.
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional. The smallest model that reliably follows the instruction.
# WG_OLLAMA_MODEL=qwen2.5:0.5b

# Set to 0 to never download a model automatically on first launch.
# WG_OLLAMA_AUTOPULL=1

# Optional. Enables the Google Sheets menu source for Digital Menu projects,
# Analytics and Search Console reports, and client connection links.
# Create an OAuth client (type: Web application) in Google Cloud Console and
# add <origin>/api/google/callback as an authorised redirect URI.
#
# One redirect URI covers both flows. A client connecting their own Google
# account to one project comes back through this same callback, so there is
# nothing extra to register.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Encrypts stored Google tokens at rest — the creator's own, and every client's
# per-project connection. Without it a key is derived from the data directory,
# which is fine for a single-user local install but NOT for a deployment
# holding other people's tokens. A deployment that sends client connection
# links holds other people's tokens by definition, so set it.
# WG_SECRET=

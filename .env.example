# Optional. Enables AI content generation and free-form AI editing.
# Without it the app works end to end using the template generator.
GEMINI_API_KEY=

# Optional. Which Gemini model the hosted-AI features use.
# WG_GEMINI_MODEL=gemini-2.5-pro

# Optional. Where the SQLite database, uploads and published sites are stored.
# WG_DATA_DIR=./data

# Optional deploy targets. Built-in hosting works with no configuration.
# VERCEL_TOKEN=
# NETLIFY_AUTH_TOKEN=

# Optional. Where the Ollama daemon lives; a small local model writes the
# design-catalogue queries. Without it a built-in rule set writes them.
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional. The smallest model that reliably follows the instruction.
# WG_OLLAMA_MODEL=qwen2.5:0.5b

# Set to 0 to never download a model automatically on first launch.
# WG_OLLAMA_AUTOPULL=1

# Optional. Enables the Google Sheets menu source for Digital Menu projects.
# Create an OAuth client (type: Web application) in Google Cloud Console and
# add <origin>/api/google/callback as an authorised redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Encrypts stored Google tokens at rest. Without it a key is derived from the
# data directory, which is fine for a single-user local install but NOT for a
# deployment holding other people's tokens.
# WG_SECRET=

# Optional. Enables AI content generation and free-form AI editing.
# Without it the app works end to end using the template generator.
ANTHROPIC_API_KEY=

# Optional. Where the SQLite database, uploads and published sites are stored.
# WG_DATA_DIR=./data

# Optional deploy targets. Built-in hosting works with no configuration.
# VERCEL_TOKEN=
# NETLIFY_AUTH_TOKEN=

# Optional. Where the Ollama daemon lives; a small local model writes the
# design-catalogue queries. Without it a built-in rule set writes them.
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional. The smallest model that reliably follows the instruction.
# WG_OLLAMA_MODEL=qwen2.5:0.5b

# Set to 0 to never download a model automatically on first launch.
# WG_OLLAMA_AUTOPULL=1

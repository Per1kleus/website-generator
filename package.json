{
  "name": "website-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first AI website & digital-menu generator",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:mobile": "node scripts/mobile-qa.mjs",
    "setup": "node scripts/setup.mjs",
    "refresh:skill": "node scripts/refresh-uiux-skill.mjs",
    "postinstall": "node scripts/setup.mjs || true",
    "test:design": "node scripts/design-engine-qa.mjs",
    "test:menu": "node scripts/menu-data-qa.mjs",
    "test:desktop": "node scripts/desktop-qa.mjs",
    "desktop:stage": "node scripts/build-desktop.mjs --no-bundle",
    "build:windows": "node scripts/build-desktop.mjs",
    "desktop:dev": "npm run build && node desktop/sidecar/launch.mjs",
    "build:android": "node scripts/build-android.mjs",
    "build:android:release": "node scripts/build-android.mjs --release",
    "build:android:bundle": "node scripts/build-android.mjs --bundle",
    "test:setup": "node scripts/setup-qa.mjs",
    "test:gemini": "node scripts/gemini-qa.mjs",
    "test:design-systems": "node --import tsx --conditions react-server scripts/design-systems-qa.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^13.0.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  }
}

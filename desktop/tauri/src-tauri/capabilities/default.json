{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only what the shell needs: run the bundled server and open the system browser for Google sign-in.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "wg-node", "sidecar": true, "args": true }]
    },
    "opener:allow-open-url"
  ]
}

node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Local runtime data (SQLite db, uploaded assets, exports).
# Anchored to the repo root: an unanchored `data/` also matches
# vendor/ui-ux-pro-max/data/, which would silently drop the design catalogue.
/data/
!/data/.gitkeep

.env
.env.local
.DS_Store
test-results/
playwright-report/
qa-screenshots/

# Python bytecode from the vendored skill
__pycache__/
*.pyc

# Generated by the packaging scripts. The Android web shell is rendered from
# mobile/android-shell/src/, and the Android project itself is created by
# `npx cap add android`; neither belongs in version control.
/mobile/android-shell/www/
/mobile/android/
/mobile/node_modules/
/desktop/tauri/src-tauri/binaries/
/desktop/tauri/src-tauri/python/
/desktop/tauri/src-tauri/target/

# Generated by tauri-build on every compile.
/desktop/tauri/src-tauri/gen/
